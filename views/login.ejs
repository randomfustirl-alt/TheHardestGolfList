<%- include('partials/head') %>
<%- include('partials/nav', { activePage: '' }) %>

<div class="auth-page">
  <div class="container">
    <div class="auth-card">
      <h1 class="auth-card__heading">Sign in</h1>
      <p class="auth-card__sub">Access your LEVEL/LIST dashboard and account.</p>

      <% if (error) { %>
        <div class="alert alert--error"><%= error %></div>
      <% } %>

      <form action="/login" method="POST">
        <div class="form-group">
          <label class="form-label" for="username">Username</label>
          <input type="text" id="username" name="username" class="form-input" placeholder="Enter your username" value="<%= formData.username || '' %>" required autofocus>
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Password</label>
          <input type="password" id="password" name="password" class="form-input" placeholder="Enter your password" required>
        </div>

        <button type="submit" class="btn btn--navy btn--full" style="margin-top: 1.5rem;">Sign In</button>
      </form>

      <div class="auth-divider">
        Don't have an account? <a href="/register">Join the list</a>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

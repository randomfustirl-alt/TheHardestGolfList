<%- include('partials/head') %>
<%- include('partials/nav', { activePage: 'list' }) %>

<div class="page-header">
  <div class="container">
    <div class="label page-header__label">THE PUBLIC RECORD · UPDATED CONTINUOUSLY</div>
    <h1 class="page-header__heading">The hardest levels, ranked.</h1>
    <p class="page-header__desc">Browse the officially verified levels ranked strictly by overall difficulty and challenge.</p>
  </div>
</div>

<div class="container">
  <form action="/list" method="GET" class="filter-bar">
    <div class="filter-bar__search">
      <svg class="filter-bar__search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" name="q" class="input" placeholder="Search level, creator, verifier..." value="<%= search %>">
    </div>

    <select name="difficulty" class="select" onchange="this.form.submit()">
      <option value="">All Difficulties</option>
      <% difficulties.forEach(d => { %>
        <option value="<%= d %>" <%= difficulty === d ? 'selected' : '' %>><%= d %></option>
      <% }) %>
    </select>

    <select name="sort" class="select" onchange="this.form.submit()">
      <option value="rank" <%= sort === 'rank' ? 'selected' : '' %>>Sort: Rank (#1 to last)</option>
      <option value="points_desc" <%= sort === 'points_desc' ? 'selected' : '' %>>Sort: Highest Points</option>
      <option value="points_asc" <%= sort === 'points_asc' ? 'selected' : '' %>>Sort: Lowest Points</option>
      <option value="clears" <%= sort === 'clears' ? 'selected' : '' %>>Sort: Most Clears</option>
      <option value="name" <%= sort === 'name' ? 'selected' : '' %>>Sort: Name</option>
    </select>
  </form>

  <div class="level-list">
    <% if (levels.length > 0) { %>
      <div class="level-list__header">
        <div>Rank</div>
        <div>Level Name</div>
        <div>Difficulty</div>
        <div>Points</div>
        <div>Creator</div>
        <div>Verifier</div>
        <div style="text-align: center;">Clears</div>
      </div>

      <% levels.forEach(level => { %>
        <a href="/level/<%= level.id %>" class="level-row">
          <div class="level-row__rank">#<%= padRank(level.rank) %></div>
          <div>
            <div class="level-row__name"><%= level.name %></div>
          </div>
          <div>
            <span class="badge <%= difficultyClass(level.difficulty) %>"><%= level.difficulty %></span>
          </div>
          <div class="level-row__pts"><%= formatPoints(level.points) %><span class="level-row__pts-unit">pts</span></div>
          <div class="level-row__meta"><%= level.creator %></div>
          <div class="level-row__meta"><%= level.verifier %></div>
          <div class="level-row__clears"><%= level.clear_count %></div>
        </a>
      <% }) %>
    <% } else { %>
      <div class="empty-state">
        <svg class="empty-state__icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="9" y1="9" x2="15" y2="15"></line>
          <line x1="15" y1="9" x2="9" y2="15"></line>
        </svg>
        <div class="empty-state__title">No levels found</div>
        <div class="empty-state__desc">There are no levels matching your query or no levels have been added to the list yet.</div>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>

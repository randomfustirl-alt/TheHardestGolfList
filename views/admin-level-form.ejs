<%- include('partials/head') %>
<%- include('partials/nav', { activePage: 'admin' }) %>

<div class="admin-page">
  <div class="container container--narrow">
    <div class="auth-card" style="max-width: 100%;">
      <h1 class="auth-card__heading"><%= level ? 'Edit Level' : 'Add New Level' %></h1>
      <p class="auth-card__sub"><%= level ? `Update details for "${level.name}"` : 'Add a new impossible level to the public list.' %></p>

      <% if (error) { %>
        <div class="alert alert--error"><%= error %></div>
      <% } %>

      <form action="<%= level ? '/admin/level/' + level.id : '/admin/level' %>" method="POST">
        <div class="form-group">
          <label class="form-label" for="name">Level Name</label>
          <input type="text" id="name" name="name" class="form-input" placeholder="e.g. Acheron" value="<%= level ? level.name : '' %>" required>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
          <div class="form-group">
            <label class="form-label" for="rank">Rank Position</label>
            <input type="number" id="rank" name="rank" class="form-input" min="1" value="<%= level ? level.rank : nextRank %>" required>
          </div>

          <div class="form-group">
            <label class="form-label" for="difficulty">Difficulty</label>
            <select name="difficulty" id="difficulty" class="select" style="width: 100%; height: 45px;" required>
              <option value="Mythic" <%= level && level.difficulty === 'Mythic' ? 'selected' : '' %>>Mythic</option>
              <option value="Extreme" <%= level && level.difficulty === 'Extreme' ? 'selected' : (!level ? 'selected' : '') %>>Extreme</option>
              <option value="Insane" <%= level && level.difficulty === 'Insane' ? 'selected' : '' %>>Insane</option>
              <option value="Hard" <%= level && level.difficulty === 'Hard' ? 'selected' : '' %>>Hard</option>
              <option value="Medium" <%= level && level.difficulty === 'Medium' ? 'selected' : '' %>>Medium</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="points">Point Value</label>
            <input type="number" id="points" name="points" class="form-input" min="1" placeholder="1000" value="<%= level ? level.points : '' %>" required>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          <div class="form-group">
            <label class="form-label" for="creator">Creator Name</label>
            <input type="text" id="creator" name="creator" class="form-input" placeholder="e.g. Ryamu" value="<%= level ? level.creator : '' %>" required>
          </div>

          <div class="form-group">
            <label class="form-label" for="verifier">Verifier Name</label>
            <input type="text" id="verifier" name="verifier" class="form-input" placeholder="e.g. Zoink" value="<%= level ? level.verifier : '' %>" required>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="description">Description (Optional)</label>
          <textarea id="description" name="description" class="form-input" rows="4" placeholder="Level details, verification notes, history..."><%= level ? level.description : '' %></textarea>
        </div>

        <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
          <button type="submit" class="btn btn--lime"><%= level ? 'Save Changes' : 'Create Level' %></button>
          <a href="/admin" class="btn btn--outline">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

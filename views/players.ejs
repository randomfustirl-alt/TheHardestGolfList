<%- include('partials/head') %>
<%- include('partials/nav', { activePage: 'players' }) %>

<div class="page-header">
  <div class="container">
    <div class="label page-header__label">THE COMMUNITY · PUBLIC PROFILES</div>
    <h1 class="page-header__heading">Find your rivals.</h1>
    <p class="page-header__desc">Discover players competing for top ranking in the public record.</p>
  </div>
</div>

<div class="container">
  <form action="/players" method="GET" class="filter-bar">
    <div class="filter-bar__search">
      <svg class="filter-bar__search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" name="q" class="input" placeholder="Search players..." value="<%= search %>">
    </div>
  </form>

  <% if (players.length > 0) { %>
    <div class="player-grid">
      <% players.forEach(p => { %>
        <a href="/player/<%= p.username %>" class="player-card">
          <div class="player-card__top">
            <%- include('partials/avatar', { name: p.display_name, username: p.username, size: 'lg' }) %>
            <span class="player-card__rank">RANK #<%= p.rank %></span>
          </div>

          <div class="player-card__identity">
            <div class="player-card__display"><%= p.display_name %></div>
            <div class="player-card__username">@<%= p.username %></div>
          </div>

          <div class="player-card__stats">
            <div class="player-card__stat">
              <div class="player-card__stat-value"><%= formatPoints(p.total_points) %></div>
              <div class="player-card__stat-label">Points</div>
            </div>
            <div class="player-card__stat">
              <div class="player-card__stat-value"><%= p.verified_clears %></div>
              <div class="player-card__stat-label">Clears</div>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state" style="padding: 5rem 0;">
      <svg class="empty-state__icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="12" cy="8" r="5"></circle>
        <path d="M20 21a8 8 0 1 0-16 0"></path>
      </svg>
      <div class="empty-state__title">No players found</div>
      <div class="empty-state__desc">There are no registered players on the platform yet.</div>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
